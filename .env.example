# Copy to .env.local. Client-safe values only: the project URL and the publishable (or legacy anon) key.
# Never put GEMINI_API_KEY, the Supabase secret/service-role key, or any other server secret here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
